# Database Configuration (PostgreSQL)
POSTGRES_USER=ikk_user
POSTGRES_PASSWORD=ganti_dengan_password_db_yang_kuat
POSTGRES_DB=ikk_db
DATABASE_URL=postgresql+asyncpg://ikk_user:ganti_dengan_password_db_yang_kuat@localhost:5432/ikk_db
TEST_DATABASE_URL=postgresql+asyncpg://ikk_user:ikk_password@localhost:5432/ikk_test_db

# Security (WAJIB diganti sebelum deploy produksi; minimal 32 karakter acak, misal: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production-min-32-chars
COOKIE_SECURE=true
ADMIN_INITIAL_PASSWORD=ganti_password_admin_kuat
DEMO_INITIAL_PASSWORD=ganti_password_awal_kuat

# Upload Bukti Dukung
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
SIMPAN_KONTEN_DB=false

# Environment & CORS
ENVIRONMENT=production
ENABLE_API_DOCS=false
CORS_ORIGINS=https://domain-anda.go.id
CORS_ORIGIN_REGEX=
