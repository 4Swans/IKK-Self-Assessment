# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ikk_user:ikk_password@localhost:5432/ikk_db
TEST_DATABASE_URL=postgresql+asyncpg://ikk_user:ikk_password@localhost:5432/ikk_test_db

# Security
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production-min-32-chars
COOKIE_SECURE=false
ADMIN_INITIAL_PASSWORD=admin@#!

# Upload Bukti Dukung
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# SMTP Email OTP Verification (Opsional untuk development, isi saat produksi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply-ikk@komdigi.go.id
SMTP_USE_TLS=true
